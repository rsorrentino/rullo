<workout_file>
    <author>Rullo</author>
    <name>FTP Builder</name>
    <description>Progressive 95-105% FTP blocks.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <SteadyState Duration="600" Power="0.70"/>
        <SteadyState Duration="600" Power="0.80"/>
        <SteadyState Duration="600" Power="0.95"/>
        <SteadyState Duration="300" Power="0.60"/>
        <SteadyState Duration="600" Power="1.00"/>
        <SteadyState Duration="300" Power="0.60"/>
        <SteadyState Duration="600" Power="1.05"/>
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45"/>
    </workout>
</workout_file>
