<workout_file>
    <author>Rullo</author>
    <name>VO2 Intervals</name>
    <description>6 x 3 min at 118% FTP with 3 min easy between.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="180" OnPower="1.18" OffPower="0.55"/>
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45"/>
    </workout>
</workout_file>
