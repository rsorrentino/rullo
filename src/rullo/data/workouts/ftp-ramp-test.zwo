<workout_file>
    <author>Rullo</author>
    <name>FTP Ramp Test</name>
    <description>Ramp in one-minute steps until you cannot hold the target. Rullo ends the test and estimates your FTP as 75% of your best minute.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="RAMP_TEST"/>
    </tags>
    <workout>
        <Warmup Duration="300" PowerLow="0.40" PowerHigh="0.60"/>
        <SteadyState Duration="60" Power="0.50"/>
        <SteadyState Duration="60" Power="0.56"/>
        <SteadyState Duration="60" Power="0.62"/>
        <SteadyState Duration="60" Power="0.68"/>
        <SteadyState Duration="60" Power="0.74"/>
        <SteadyState Duration="60" Power="0.80"/>
        <SteadyState Duration="60" Power="0.86"/>
        <SteadyState Duration="60" Power="0.92"/>
        <SteadyState Duration="60" Power="0.98"/>
        <SteadyState Duration="60" Power="1.04"/>
        <SteadyState Duration="60" Power="1.10"/>
        <SteadyState Duration="60" Power="1.16"/>
        <SteadyState Duration="60" Power="1.22"/>
        <SteadyState Duration="60" Power="1.28"/>
        <SteadyState Duration="60" Power="1.34"/>
        <SteadyState Duration="60" Power="1.40"/>
        <SteadyState Duration="60" Power="1.46"/>
        <SteadyState Duration="60" Power="1.52"/>
        <SteadyState Duration="60" Power="1.58"/>
        <SteadyState Duration="60" Power="1.64"/>
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.35"/>
    </workout>
</workout_file>
