<workout_file>
    <author>Rullo</author>
    <name>Sweet Spot 3x12</name>
    <description>3 x 12 min at 90% FTP.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="300" OnPower="0.90" OffPower="0.55"/>
        <Cooldown Duration="540" PowerLow="0.65" PowerHigh="0.45"/>
    </workout>
</workout_file>
